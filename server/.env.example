# WasteWise Server Configuration
PORT=5000

# MongoDB Connection String (Local mongod or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/wastewise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wastewise

# JSON Web Token Secret
JWT_SECRET=wastewise_secret_key_2026_super_secure
