# WasteWise Backend Configuration

PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/wastewise?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Required JSON Web Token Secret (generate a strong random secret)
JWT_SECRET=replace_with_a_long_random_secret

# Optional Admin Bootstrap Credentials (used for initial setup/seed)
ADMIN_NAME=Admin Supervisor
ADMIN_EMAIL=admin@wastewise.org
ADMIN_PASSWORD=replace_with_secure_admin_password
